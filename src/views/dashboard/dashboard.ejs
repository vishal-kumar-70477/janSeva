<!-- AUTH MODAL -->
<div id="auth" class="hidden fixed inset-0 z-[60] auth-overlay p-4 overflow-y-auto" role="dialog" aria-modal="true" aria-label="Authentication">
 <div class="auth-shell">
  <div class="auth-left">
   <div class="auth-logo-wrap"><img src="/assets/01-janseva-logo.png" alt="JanSeva" class="auth-logo"></div>
   <div>
    <p class="auth-quote">"Care starts with the right information."</p>
    <ul class="auth-points">
     <li>Secure &amp; Privacy Focused</li>
     <li>Connected Healthcare</li>
     <li>People First</li>
    </ul>
   </div>
  </div>
  <div class="auth-right">
   <button onclick="closeAuth()" class="auth-close" aria-label="Close"><i data-lucide="x" style="width:16px;height:16px"></i></button>

   <div id="stepRole" class="auth-step">
    <h2>Welcome to JanSeva</h2><p class="sub">Choose your role to continue.</p>
    <div class="role-grid">
     <button class="role-card" onclick="selectRole('patient')"><div class="ic"><i data-lucide="users"></i></div><h3>Patient / Family</h3><p>Manage your health information and emergency details.</p></button>
     <button class="role-card" onclick="selectRole('doctor')"><div class="ic"><i data-lucide="stethoscope"></i></div><h3>Doctor</h3><p>Manage incoming cases and coordinate patient care.</p></button>
     <button class="role-card" onclick="selectRole('hospital')"><div class="ic"><i data-lucide="hospital"></i></div><h3>Hospital</h3><p>Manage emergency cases, beds, doctors and hospital readiness.</p></button>
     <button class="role-card" onclick="selectRole('admin')"><div class="ic"><i data-lucide="shield"></i></div><h3>Administrator</h3><p>Manage the JanSeva healthcare network.</p></button>
    </div>
   </div>

   <div id="stepChoice" class="auth-step hidden">
    <button class="back-link" onclick="goStep('stepRole')">← Change Role</button>
    <h2><span id="choiceRoleLabel"></span></h2>
    <div class="tab-switch">
     <button id="tabLogin" class="active" onclick="showAuthMode('login')">Login</button>
     <button id="tabRegister" onclick="showAuthMode('register')">Create Account</button>
    </div>
    <div id="modeArea" class="mt-5"></div>
   </div>

   <div id="stepSuccess" class="auth-step hidden"></div>
  </div>
 </div>
</div>

